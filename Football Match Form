  function loadMatches() {
    var x2 = new XMLHttpRequest();
    x2.open('GET', GAS + '?action=getMatches', true);
    x2.onload = function() {
      try {
        var d = JSON.parse(x2.responseText);
        var list = document.getElementById('fbf-dropdown-list');
        list.innerHTML = '';
        var matches = d.matches || [];
        if (matches.length === 0) {
          var e = document.createElement('div'); e.className = 'fbf-dropdown-item empty'; e.textContent = 'Tidak ada pertandingan yang sedang berlangsung.'; list.appendChild(e);
        }
        matches.forEach(function(m) {
          matchMeta[m.code] = m;
          var tag = ' [' + (m.matchType || 'PvNPC') + ']';
          var label = m.code + ' — ' + m.schoolA + ' vs ' + m.schoolB + tag;
          var item = document.createElement('div');
          item.className = 'fbf-dropdown-item';
          item.setAttribute('data-code', m.code);
          item.textContent = label;
          item.onclick = function(e) { e.stopPropagation(); onMatchSelected(m.code, label); };
          list.appendChild(item);
        });
      } catch(e) {}
    };
    x2.send();
