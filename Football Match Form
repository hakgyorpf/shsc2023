  function progressBar(label, val, color) {
    var pct = Math.min(100, Math.round((val/50)*100));
    return '<div class="fbf-progress-row"><div class="fbf-progress-label"><span>'+esc(label)+'</span><span>'+val+' / 50</span></div>' +
      '<div class="fbf-progress-bar"><div class="fbf-progress-fill" style="width:'+pct+'%; background:'+color+';"></div></div></div>';
  }

  function loadScore(code, rebuildSideUI) {
    var box = document.getElementById('fbf-score');
    if (!code) { box.style.display = 'none'; return; }
    box.style.display = 'block';
    box.innerHTML = '<span style="color:var(--text-on-deep-secondary)">Loading match state...</span>';
    var x3 = new XMLHttpRequest();
    x3.open('GET', GAS + '?action=getScore&matchCode=' + encodeURIComponent(code), true);
    x3.onload = function() {
      try {
        var d = JSON.parse(x3.responseText);
        if (d.error) { box.innerHTML = d.error; return; }
        scoreData = d;
        var html = '<div class="fbf-score-badges">';
        html += '<span class="fbf-score-typebadge ' + (d.matchType==='PvP'?'pvp':'pvnpc') + '">' + d.matchType + '</span>';
        html += '<span class="fbf-score-typebadge phase">' + (d.phase||'—') + (d.status==='active' ? (" · " + (d.halfMinute||0) + "'") : '') + '</span>';
        html += '</div>';
        html += '<div class="fbf-score-vs">';
        html += '<div class="fbf-score-side"><div class="fbf-score-name">' + esc(d.schoolA||'') + '</div><div class="fbf-score-points">' + (d.scoreA||0) + '</div></div>';
        html += '<div class="fbf-score-vsbutton">VS</div>';
        html += '<div class="fbf-score-side"><div class="fbf-score-name">' + esc(d.schoolB||'') + '</div><div class="fbf-score-points">' + (d.scoreB||0) + '</div></div>';
        html += '</div>';
        html += progressBar(d.schoolA + ' progress', d.progressA||0, 'var(--accent-2)');
        html += progressBar(d.schoolB + ' progress', d.progressB||0, 'var(--gold)');
        if (d.status === 'active' && d.shootReady) {
          var shootName = d.shootReady === 'A' ? d.schoolA : d.schoolB;
          html += '<div class="fbf-possession-note">🎯 ' + esc(shootName) + ' sedang menembak</div>';
        } else if (d.status === 'active' && d.teamInAttack) {
          var attName = d.teamInAttack === 'A' ? d.schoolA : d.schoolB;
          html += '<div class="fbf-possession-note">⚽ ' + esc(attName) + ' sedang menyerang</div>';
        }
        if (d.status === 'finished') html += '<div class="fbf-score-clockinfo">Match sudah selesai.</div>';
        if (d.status === 'halftime') html += '<div class="fbf-score-clockinfo">Menunggu babak/fase berikutnya dimulai.</div>';
        box.innerHTML = html;

        if (rebuildSideUI) buildCharacterUI();
        buildActionArea(d);
      } catch(e) {}
    };
    x3.send();
  }

  // Client-side mirror of the backend's requireGkOwnerIfSave lock: a
  // Save may only be rolled as the side's actually-registered GK
  // (roster Position === 'GK'). Checking this here — before the
  // rolling overlay opens — means a non-GK selection never gets as
  // far as the animation before being told no; the backend still
  // enforces the same rule as the source of truth.
  function isCurCharacterGK() {
    for (var i = 0; i < rosterList.length; i++) {
      if (rosterList[i].characterName === curCharacterName) return rosterList[i].position === 'GK';
    }
    return false;
  }

  function renderStylePicker(area) {
    var wrap = document.createElement('div');
    wrap.className = 'fbf-style-row';
    STYLE_TYPES.forEach(function(st) {
      var b = document.createElement('button');
      b.type = 'button';
      b.className = 'fbf-style-btn';
      b.textContent = STYLE_LABELS[st];
      if (selectedStyle === st) b.classList.add('selected');
      b.onclick = function() {
        selectedStyle = st;
        wrap.querySelectorAll('.fbf-style-btn').forEach(function(x){ x.classList.remove('selected'); });
        b.classList.add('selected');
      };
      wrap.appendChild(b);
    });
    area.appendChild(wrap);
    var hint = document.createElement('div');
    hint.className = 'fbf-style-hint';
    hint.textContent = 'Pace > Power > Skill > Pace — gaya ini menentukan siapa menang duel.';
    area.appendChild(hint);
  }

  function buildActionArea(d) {
    var area = document.getElementById('fbf-action-area');
    var submitArea = document.getElementById('fbf-submit-area');
    var icField = document.getElementById('fbf-ic-field');
    area.innerHTML = '';
    submitArea.innerHTML = '';
    if (!curCharacterName || !curSide) { icField.style.display = 'none'; return; }
    if (!d || d.status === 'finished') { icField.style.display = 'none'; return; }

    // Not kicked off yet — kick off IS the restart pass now (same shape
    // as any other roll: pick a style, then roll), not a separate step
    // before one.
    if (!d.teamInAttack) {
      icField.style.display = 'block';
      selectedStyle = '';
      renderStylePicker(area);
      var kbtn = document.createElement('button');
      kbtn.className = 'fbf-btn'; kbtn.textContent = 'Kick Off! ⚽';
      kbtn.onclick = doKickoff;
      submitArea.appendChild(kbtn);
      return;
    }

    if (d.status === 'halftime') { icField.style.display = 'none'; renderAdminControls(submitArea, d); return; }

    // Shoot flow
    var shootSide = d.shootReady;
    var gkSide = shootSide === 'A' ? 'B' : 'A';
    if (shootSide) {
      if (d.pendingShootRole) {
        if (d.pendingShootSide === curSide) {
          area.innerHTML = '<div class="fbf-waitbox">Kamu sudah roll. Menunggu tim lawan menyelesaikan tembakan...</div>';
          icField.style.display = 'none';
          return;
        }
        // GK-only lock, checked client-side BEFORE the rolling overlay
        // ever opens — the backend enforces this too (requireGkOwnerIfSave),
        // but catching it here means a non-GK character never sees the
        // animation flash before the error.
        if (curSide !== shootSide && !isCurCharacterGK()) {
          area.innerHTML = '<div class="fbf-waitbox">Hanya kiper terdaftar tim ini yang bisa roll Save. Pilih karakter kiper di atas.</div>';
          icField.style.display = 'none';
          return;
        }
        icField.style.display = 'block';
        selectedStyle = '';
        renderStylePicker(area);
        var rbtn = document.createElement('button');
        rbtn.className = 'fbf-btn shoot';
        rbtn.textContent = curSide === shootSide ? 'Roll Shoot!' : 'Roll Save!';
        rbtn.onclick = doShoot;
        submitArea.appendChild(rbtn);
        return;
      }
      if (curSide === shootSide) {
        icField.style.display = 'block';
        selectedStyle = '';
        renderStylePicker(area);
        var sbtn = document.createElement('button');
        sbtn.className = 'fbf-btn shoot';
        sbtn.textContent = (SHOOT_TYPE_LABEL[d.shootType] || 'Shoot!') + ' ⚽';
        sbtn.onclick = doShoot;
        submitArea.appendChild(sbtn);
        return;
      }
      // PvNPC/NPCvNPC: the shooting side is NPC-controlled, and the NPC's
      // shot resolves automatically in the SAME call as the human GK's
      // Save — there's no separate "shooter goes first" step to wait on
      // (see resolvePvNPCShoot on the backend). So the GK always has an
      // action available immediately, no waiting box. PvP still waits
      // here, since there the shooter really does have to roll first.
      if (curSide === gkSide && (d.matchType === 'PvNPC' || d.matchType === 'NPCvNPC')) {
        icField.style.display = 'block';
        var npcNote = document.createElement('div');
        npcNote.className = 'fbf-note';
        npcNote.style.marginBottom = '0.5rem';
        npcNote.textContent = (shootSide === 'A' ? d.schoolA : d.schoolB) + ' menembak! Giliran kiper ' + (gkSide === 'A' ? d.schoolA : d.schoolB) + ' roll.';
        area.appendChild(npcNote);
        if (!isCurCharacterGK()) {
          var gkBlock = document.createElement('div');
          gkBlock.className = 'fbf-waitbox';
          gkBlock.textContent = 'Hanya kiper terdaftar tim ini yang bisa roll Save. Pilih karakter kiper di atas.';
          area.appendChild(gkBlock);
          icField.style.display = 'none';
          return;
        }
        selectedStyle = '';
        renderStylePicker(area);
        var nsbtn = document.createElement('button');
        nsbtn.className = 'fbf-btn shoot';
        nsbtn.textContent = 'Save!';
        nsbtn.onclick = doShoot;
        submitArea.appendChild(nsbtn);
        return;
      }
      area.innerHTML = '<div class="fbf-waitbox">Menunggu ' + esc(shootSide==='A'?d.schoolA:d.schoolB) + ' melakukan tembakan...</div>';
      icField.style.display = 'none';
      return;
    }

    // Open-play contest
    if (d.pendingRole) {
      if (d.pendingSide === curSide) {
        area.innerHTML = '<div class="fbf-waitbox">Kamu sudah roll. Menunggu tim lawan...</div>';
        icField.style.display = 'none';
        return;
      }
      var lockedAction = matchAction(d.pendingAction);
      icField.style.display = 'block';
      selectedStyle = '';
      renderStylePicker(area);
      var abtn = document.createElement('button');
      abtn.className = 'fbf-btn';
      abtn.textContent = 'Roll ' + ACTION_LABELS[lockedAction];
      abtn.onclick = function() { selectedAction = lockedAction; doRoll(); };
      submitArea.appendChild(abtn);
      return;
    }

    // First mover — choose action
    var myRole = curSide === d.teamInAttack ? 'attack' : 'defend';
    icField.style.display = 'block';

    // Goal kick restart: the side now in attack must take a goal kick
    // before anything else can happen, and — unlike kickoff — the GK's
    // side has to go first: the backend rejects the opponent rolling
    // here at all (their Interception only exists as the matched
    // response to the GK's own roll, once that's parked as pending).
    if (d.goalKickPending) {
      var takingGoalKick = curSide === d.teamInAttack;
      if (!takingGoalKick) {
        var waitSchool = d.teamInAttack === 'A' ? d.schoolA : d.schoolB;
        area.innerHTML = '<div class="fbf-waitbox">Menunggu ' + esc(waitSchool) + ' melakukan Goal Kick...</div>';
        icField.style.display = 'none';
        return;
      }
      if (!isCurCharacterGK()) {
        area.innerHTML = '<div class="fbf-waitbox">Hanya kiper terdaftar tim ini yang bisa melakukan Goal Kick. Pilih karakter kiper di atas.</div>';
        icField.style.display = 'none';
        return;
      }
      var gkNote = document.createElement('div');
      gkNote.className = 'fbf-note';
      gkNote.style.marginBottom = '0.5rem';
      gkNote.textContent = 'Goal kick! Kiper harus menendang bola dulu sebelum lanjut open play.';
      area.appendChild(gkNote);
      icField.style.display = 'block';
      selectedStyle = '';
      renderStylePicker(area);
      var gkbtn = document.createElement('button');
      gkbtn.className = 'fbf-btn';
      gkbtn.textContent = 'Goal Kick! ⚽';
      gkbtn.onclick = function() { selectedAction = 'goalkick'; doRoll(); };
      submitArea.appendChild(gkbtn);
      return;
    }

    // Kickoff/restart: the pass hasn't happened yet, so nobody can
    // dribble or tackle — forced into Pass (attack) / Interception
    // (defend), same as the server enforces regardless of what's sent.
    if (d.kickoffPending) {
      var koNote = document.createElement('div');
      koNote.className = 'fbf-note';
      koNote.style.marginBottom = '0.5rem';
      koNote.textContent = 'Kick off! Bola belum bisa digiring — operan dulu.';
      area.appendChild(koNote);
      selectedStyle = '';
      renderStylePicker(area);
      var forcedAction = myRole === 'attack' ? 'pass' : 'interception';
      var kobtn = document.createElement('button');
      kobtn.className = 'fbf-btn';
      kobtn.textContent = 'Roll ' + ACTION_LABELS[forcedAction];
      kobtn.onclick = function() { selectedAction = forcedAction; doRoll(); };
      submitArea.appendChild(kobtn);
      return;
    }

    selectedStyle = '';
    var options = myRole === 'attack' ? ['dribble','pass'] : ['tackle','interception'];
    var rowDiv = document.createElement('div');
    rowDiv.className = 'fbf-action-row';
    options.forEach(function(opt) {
      var b = document.createElement('button');
      b.type = 'button';
      b.className = 'fbf-action-btn';
      b.textContent = ACTION_LABELS[opt];
      b.onclick = function() {
        selectedAction = opt;
        rowDiv.querySelectorAll('.fbf-action-btn').forEach(function(x){ x.classList.remove('selected'); });
        b.classList.add('selected');
      };
      rowDiv.appendChild(b);
    });
    area.appendChild(rowDiv);
    renderStylePicker(area);
    var goBtn = document.createElement('button');
    goBtn.className = 'fbf-btn';
    goBtn.textContent = 'Roll ↯';
    goBtn.onclick = doRoll;
    submitArea.appendChild(goBtn);
  }

  function renderAdminControls(area, d) {
    if (loggedInUsername !== 'Seonbi') {
      area.innerHTML = '<div class="fbf-waitbox">Menunggu babak/fase berikutnya dimulai oleh admin.</div>';
      return;
    }
    var btn = document.createElement('button');
    btn.className = 'fbf-btn';
    if (d.phase === 'H1') { btn.textContent = 'Mulai Babak Kedua'; btn.onclick = function(){ doPhaseAction('startSecondHalf'); }; }
    else { btn.textContent = 'Mulai Extra Time'; btn.onclick = function(){ doPhaseAction('startExtraTime'); }; }
    area.appendChild(btn);
  }

  function doPhaseAction(action) {
    var x = new XMLHttpRequest();
    x.open('POST', GAS, true);
    x.setRequestHeader('Content-Type', 'text/plain');
    x.onload = function() { loadScore(curMatch, false); };
    x.send(JSON.stringify({ action: action, matchCode: curMatch }));
  }

  function showErr(msg) { var el = document.getElementById('fbf-err'); el.textContent = msg; el.style.display = 'block'; }

  function doKickoff() {
    var err = document.getElementById('fbf-err'); err.style.display = 'none';
    if (!curMatch) { showErr('Pilih pertandingan dulu.'); return; }
    if (!curCharacterName || !curSide) { showErr('Pilih nama karaktermu dulu.'); return; }
    if (!selectedStyle) { showErr('Pilih gaya main dulu: Pace, Power, atau Skill.'); return; }
    var ic = document.getElementById('fbf-ic').value.trim();
    beginRolling(ACTION_VERBING.kickoff);
    // Kick off IS the restart pass now (server resolves it through the
    // same code path as submitRoll), so it returns a normal contest
    // result — reveal it the same way as any other roll.
    postGAS({ action: 'kickoff', matchCode: curMatch, characterName: curCharacterName, styleType: selectedStyle, icLine: ic, loggedInUsername: loggedInUsername }, function(d) {
      if (d.error) { hideRolling(); showErr(d.error); return; }
      afterAnim(d, runContestReveal);
    });
  }

  function doRoll() {
    var err = document.getElementById('fbf-err'); err.style.display = 'none';
    if (!curMatch) { showErr('Pilih pertandingan dulu.'); return; }
    if (!curCharacterName || !curSide) { showErr('Pilih nama karaktermu dulu.'); return; }
    if (!selectedAction) { showErr('Pilih aksi dulu.'); return; }
    if (!selectedStyle) { showErr('Pilih gaya main dulu: Pace, Power, atau Skill.'); return; }
    var ic = document.getElementById('fbf-ic').value.trim();
    beginRolling(ACTION_VERBING[selectedAction] || 'Rolling...');
    postGAS({ action: 'submitRoll', matchCode: curMatch, characterName: curCharacterName, chosenAction: selectedAction, styleType: selectedStyle, icLine: ic, loggedInUsername: loggedInUsername }, function(d) {
      if (d.error) { hideRolling(); showErr(d.error); return; }
      afterAnim(d, runContestReveal);
    });
  }

  function doShoot() {
    var err = document.getElementById('fbf-err'); err.style.display = 'none';
    if (!curMatch) { showErr('Pilih pertandingan dulu.'); return; }
    if (!curCharacterName || !curSide) { showErr('Pilih nama karaktermu dulu.'); return; }
    if (!selectedStyle) { showErr('Pilih gaya main dulu: Pace, Power, atau Skill.'); return; }
    var ic = document.getElementById('fbf-ic').value.trim();
    var actingAsShooter = scoreData && curSide === scoreData.shootReady;
    beginRolling(actingAsShooter ? ACTION_VERBING.shoot : ACTION_VERBING.save);
    postGAS({ action: 'submitShoot', matchCode: curMatch, characterName: curCharacterName, styleType: selectedStyle, icLine: ic, loggedInUsername: loggedInUsername }, function(d) {
      if (d.error) { hideRolling(); showErr(d.error); return; }
      afterAnim(d, runShootReveal);
    });
  }

  // ---- Rolling overlay: multi-stage reveal (English narration) ----
  // 1. anim-stage: a short "doing the action" beat, held ~3s regardless
  //    of how fast the server answers (afterAnim queues the response
  //    until the beat finishes, mirroring Badminton's pattern).
  // 2. reveal-stage, box 1: name + "is X-ing..." only.
  // 3. reveal-stage, box 2: name + "is X-ing..." only.
  // 4. back to box 1: style + dice roll.
  // 5. box 2: style + dice roll.
  // 6. margin, then the succeed/fail headline, then the full narrative
  //    description — each appearing in turn — and only then does the
  //    "View Match Page" link show up.

  // Both the "server answered before the 3s beat" path (here) and the
  // "beat finished first" path (beginRolling's timer, below) call the
  // reveal function with zero surrounding try/catch of their own — a bug
  // in runContestReveal/runShootReveal would otherwise
  // throw silently and leave the overlay stuck blank with no error shown,
  // even though the roll already succeeded server-side. safeReveal makes
  // that failure visible instead.
  function safeReveal(fn, d) {
    try {
      fn(d);
    } catch (e) {
      console.error('reveal render error:', e);
      hideRolling();
      showErr('Gagal menampilkan hasil roll (tersimpan di server). Coba muat ulang halaman. (' + e.message + ')');
    }
  }

  function afterAnim(d, fn) {
    if (actionLoadingDone) { safeReveal(fn, d); return; }
    pendingRollResult = { d: d, fn: fn };
  }

  function rollAnim(el, finalVal, duration) {
    el.style.animation = 'fbfFlicker 0.08s linear infinite';
    var interval = setInterval(function() { el.textContent = Math.floor(Math.random()*100)+1; }, 80);
    setTimeout(function() { clearInterval(interval); el.style.animation = ''; el.textContent = finalVal; }, duration);
  }

  // Phase 1 of a box's reveal: just the character's name and what
  // they're doing ("is tackling..."), no style or roll yet.
  function showBoxIntro(prefix, name, actionText) {
    var row = document.getElementById('fbf-row-' + prefix);
    row.style.display = 'block';
    row.style.opacity = '1';
    document.getElementById('fbf-row-' + prefix + '-name').textContent = name;
    document.getElementById('fbf-' + prefix + '-action').textContent = actionText;
  }

  // Phase 2: reveal that box's chosen style and animate its roll into place.
  function revealBoxRoll(prefix, styleText, roll, duration, callback) {
    var rps = document.getElementById('fbf-' + prefix + '-rps');
    rps.style.display = 'flex';
    document.getElementById('fbf-' + prefix + '-style').textContent = styleText;
    rollAnim(document.getElementById('fbf-' + prefix + '-roll'), roll, duration);
    setTimeout(callback, duration);
  }

  function showRevealStage() {
    document.getElementById('fbf-anim-stage').style.display = 'none';
    document.getElementById('fbf-reveal-stage').style.display = 'block';
    document.getElementById('fbf-margin-line').style.display = 'none';
    document.getElementById('fbf-headline-line').style.display = 'none';
    document.getElementById('fbf-full-desc').style.display = 'none';
    document.getElementById('fbf-waiting-text').style.display = 'none';
    ['mine', 'opp'].forEach(function(p) {
      var row = document.getElementById('fbf-row-' + p);
      row.style.display = 'none'; row.style.opacity = '0.4';
      document.getElementById('fbf-' + p + '-rps').style.display = 'none';
      document.getElementById('fbf-row-' + p + '-name').textContent = '—';
      document.getElementById('fbf-' + p + '-action').textContent = '—';
      document.getElementById('fbf-' + p + '-roll').textContent = '--';
    });
    document.getElementById('fbf-goto-link').style.display = 'none';
  }

  function showMargin(margin) {
    var el = document.getElementById('fbf-margin-line');
    el.style.display = 'block';
    el.textContent = 'Margin: ' + margin;
  }

  function showHeadline(text) {
    var el = document.getElementById('fbf-headline-line');
    el.style.display = 'block';
    el.textContent = text;
  }

  function showFullDesc(html) {
    var el = document.getElementById('fbf-full-desc');
    el.style.display = 'block';
    el.innerHTML = html || '';
  }

  function showGoLink(code) {
    var a = document.getElementById('fbf-goto-link');
    a.href = MATCH_PAGE + (MATCH_PAGE.indexOf('?')===-1?'?':'&') + 'match=' + encodeURIComponent(code);
    a.style.display = 'inline-block';
    loadScore(curMatch, false);
  }

  function contestHeadline(d) {
    // Kick off is just a forced Pass/Interception exchange under the hood
    // now (server tags it isKickoffRoll), but it still deserves its own
    // banner rather than a generic "Intercept succeeded!"-type headline.
    if (d.isKickoffRoll) return 'Kick off! ⚽';
    var defendWon = d.winnerSide === d.defend.side;
    var label = ACTION_LABELS[d.defend.action] ? ACTION_LABELS[d.defend.action].replace('!','') : 'Tackle';
    return label + (defendWon ? ' succeeded!' : ' failed!');
  }

  function contestNarrative(d, meta) {
    var attName = esc(d.attack.character), defName = esc(d.defend.character);
    var attSchool = esc(d.attack.side === 'A' ? meta.schoolA : meta.schoolB);
    var defSchool = esc(d.defend.side === 'A' ? meta.schoolA : meta.schoolB);
    var defendWon = d.winnerSide === d.defend.side;
    var main;
    if (defendWon) {
      // A defend win here is always a clean, legal challenge — fouls only
      // ever occur on the OTHER branch (defend losing), so this phrasing
      // is safe to use unconditionally and makes clear no foul happened.
      var cleanVerb = d.defend.action === 'interception'
        ? ('Clean interception from ' + defName + ' on ' + attName + "'s pass")
        : ('Clean tackle from ' + defName + ' on ' + attName);
      main = cleanVerb + ' - ' + defSchool + ' has the ball possession now.';
      if (d.outcome && d.outcome !== 'open_play' && OUTCOME_CONTINUATION[d.outcome]) {
        var note = OUTCOME_CONTINUATION[d.outcome](attSchool, defSchool);
        main += '<br>' + note.charAt(0).toUpperCase() + note.slice(1);
      }
    } else {
      var verb = d.defend.action === 'interception' ? 'intercepted' : 'tackled';
      var cont = OUTCOME_CONTINUATION[d.outcome] ? OUTCOME_CONTINUATION[d.outcome](attSchool, defSchool) : (attSchool + ' still has the ball possession.');
      main = defName + ' ' + verb + ' ' + attName + ' but failed to get the ball - ' + cont;
    }
    return main;
  }

  function runContestReveal(d) {
    var meta = matchMeta[curMatch] || {};
    showRevealStage();

    if (d.status === 'pending') {
      document.getElementById('fbf-row-opp').style.display = 'none';
      showBoxIntro('mine', esc(d.myCharacter), 'is ' + (ACTION_ING[d.myAction] || 'rolling') + '...');
      setTimeout(function() {
        revealBoxRoll('mine', STYLE_LABELS[d.myStyle] || '', d.myRoll, 2000, function() {
          var waiting = document.getElementById('fbf-waiting-text');
          waiting.style.display = 'block';
          waiting.textContent = 'Waiting for ' + esc(d.waitingFor==='A'?meta.schoolA:meta.schoolB) + ' to roll...';
          showGoLink(curMatch);
        });
      }, 700);
      return;
    }

    var attSchool = d.attack.side === 'A' ? meta.schoolA : meta.schoolB;
    var defSchool = d.defend.side === 'A' ? meta.schoolA : meta.schoolB;

    // 1) name + "is X-ing..." for the attacker's box, then the defender's.
    // 2) back to the attacker's box for style + dice, then the defender's.
    // 3) margin, then the succeed/fail headline, then the full narrative.
    showBoxIntro('mine', esc(d.attack.character) + ' (' + esc(attSchool) + ')', 'is ' + ACTION_ING[d.attack.action] + '...');
    setTimeout(function() {
      showBoxIntro('opp', esc(d.defend.character) + ' (' + esc(defSchool) + ')', 'is ' + ACTION_ING[d.defend.action] + '...');
      setTimeout(function() {
        revealBoxRoll('mine', STYLE_LABELS[d.attack.style] || '', d.attack.roll, 2000, function() {
          revealBoxRoll('opp', STYLE_LABELS[d.defend.style] || '', d.defend.roll, 2000, function() {
            showMargin(d.margin);
            setTimeout(function() {
              showHeadline(contestHeadline(d));
              setTimeout(function() {
                var detail = contestNarrative(d, meta);
                if (d.incident && d.incident.cardTier) {
                  detail += '<br>[' + d.incident.cardTier + ' Card] ' + esc(d.incident.cardCharacter);
                }
                if (d.incident && d.incident.injuryOccurred) {
                  detail += '<br>' + esc(d.incident.injuredCharacter) + ' is injured.';
                }
                if (d.shootReady) {
                  detail += '<br><b>' + (SHOOT_TYPE_BANNER_EN[d.shootType] || 'Progress hits 50!') + ' ' + esc(d.shootReady==='A'?meta.schoolA:meta.schoolB) + ' can Shoot now.</b>';
                }
                showFullDesc(detail);
                showGoLink(curMatch);
              }, 1200);
            }, 700);
          });
        });
      }, 700);
    }, 700);
  }

  function shootNarrative(d) {
    var shooter = esc(d.shoot.character), gk = esc(d.save.character);
    if (d.outcome === 'goal') return shooter + ' scored past ' + gk + " - it's a GOAL!";
    if (d.outcome === 'offside') return shooter + "'s shot is called back for offside - no goal.";
    return shooter + "'s shot was saved by " + gk + ' - no goal.';
  }

  function runShootReveal(d) {
    showRevealStage();

    if (d.status === 'pending') {
      document.getElementById('fbf-row-opp').style.display = 'none';
      showBoxIntro('mine', esc(d.myCharacter), 'is shooting...');
      setTimeout(function() {
        revealBoxRoll('mine', STYLE_LABELS[d.myStyle] || '', d.myRoll, 2000, function() {
          var waiting = document.getElementById('fbf-waiting-text');
          waiting.style.display = 'block';
          waiting.textContent = 'Waiting for the opponent to roll...';
          showGoLink(curMatch);
        });
      }, 700);
      return;
    }

    showBoxIntro('mine', esc(d.shoot.character), 'is shooting...');
    setTimeout(function() {
      showBoxIntro('opp', esc(d.save.character), 'is saving...');
      setTimeout(function() {
        revealBoxRoll('mine', STYLE_LABELS[d.shoot.style] || '', d.shoot.roll, 2000, function() {
          revealBoxRoll('opp', STYLE_LABELS[d.save.style] || '', d.save.roll, 2000, function() {
            showMargin(d.margin);
            setTimeout(function() {
              var headline = d.outcome === 'goal' ? 'GOAL! ⚽' : d.outcome === 'offside' ? 'Offside — no goal.' : 'Saved!';
              showHeadline(headline);
              setTimeout(function() {
                var detail = '<i>' + shootNarrative(d) + '</i>';
                detail += '<br><br><b style="font-size:1.2em;">Score now: ' + d.scoreA + ' – ' + d.scoreB + '</b>';
                showFullDesc(detail);
                showGoLink(curMatch);
              }, 1200);
            }, 700);
          });
        });
      }, 700);
    }, 700);
  }

  function postGAS(payload, cb) {
    var xr = new XMLHttpRequest();
    xr.open('POST', GAS, true);
    xr.timeout = 25000;
    xr.setRequestHeader('Content-Type', 'text/plain');
    xr.onload = function() {
      var parsed;
      try {
        parsed = JSON.parse(xr.responseText);
      } catch (e) {
        // Log the raw body so a repeat of this error can actually be
        // diagnosed (e.g. an HTML auth/error page from Google instead of
        // JSON) instead of just showing a generic message every time.
        console.error('postGAS: non-JSON response (status ' + xr.status + '):', xr.responseText);
        hideRolling();
        showErr('Server mengembalikan respons yang tidak valid. Coba lagi.');
        return;
      }
      // cb() runs outside the try/catch above so a bug in the reveal
      // rendering (e.g. a missing DOM element) surfaces as its own real
      // error instead of being swallowed and misreported as a JSON/server
      // problem when the response was actually fine.
      cb(parsed);
    };
    xr.onerror = function() { hideRolling(); showErr('Koneksi ke server gagal.'); };
    xr.ontimeout = function() { hideRolling(); showErr('Server terlalu lama merespons. Coba lagi.'); };
    xr.send(JSON.stringify(payload));
  }

  function initLottie() {
    if (lottieAnim || typeof lottie === 'undefined') return;
    lottieAnim = lottie.loadAnimation({
      container: document.getElementById('fbf-lottie'),
      renderer: 'svg',
      loop: true,
      autoplay: true,
      path: LOTTIE_URL
    });
  }

  function beginRolling(label) {
    actionLoadingDone = false;
    pendingRollResult = null;
    document.getElementById('fbf-rolling').style.display = 'block';
    document.getElementById('fbf-anim-stage').style.display = 'block';
    document.getElementById('fbf-reveal-stage').style.display = 'none';
    document.getElementById('fbf-goto-link').style.display = 'none';
    document.getElementById('fbf-rolling-label').textContent = label;
    initLottie();
    clearTimeout(actionLoadingTimer);
    actionLoadingTimer = setTimeout(function() {
      actionLoadingTimer = null;
      actionLoadingDone = true;
      if (pendingRollResult) {
        var result = pendingRollResult;
        pendingRollResult = null;
        safeReveal(result.fn, result.d);
      }
    }, 3000);
  }
  function hideRolling() {
    clearTimeout(actionLoadingTimer);
    actionLoadingTimer = null;
    pendingRollResult = null;
    document.getElementById('fbf-rolling').style.display = 'none';
  }
})();
</script>
