<div class="fbm">
  <p class="fbm-eventname">Suwon-si High School Competition 2023</p>
  <p class="fbm-eventsub">⚽ Football Scoreboard</p>

  <div class="fbm-guide">
    <div class="fbm-guide-title">Cara Membaca Halaman Ini</div>
    <ul>
      <li>Klik salah satu pertandingan di bawah untuk melihat skor, possession, progress bar, dan feed roll-nya.</li>
      <li>Progress terkumpul per tim (tidak hilang saat bola berpindah) — begitu mencapai 50, tim itu bisa Shoot, dan progress berkurang 50 saat tembakan dilakukan (kecuali penalti).</li>
      <li>1 roll = 1 menit pertandingan. Babak = 45 roll, extra time = 15 roll per babak.</li>
      <li>Kartu merah mengurangi dice cap seluruh tim (-20, bisa menumpuk), cedera mengurangi dice cap pemain itu saja (-10) — keduanya bertahan sampai akhir pertandingan.</li>
    </ul>
  </div>

  <p class="fbm-master-title">Semua Pertandingan</p>
  <div id="fbm-master-grid"><div class="fbm-loading">Memuat seluruh pertandingan...</div></div>

  <div class="fbm-top-roll-wrap" id="fbm-top-roll-wrap" style="display:none;">
    <a class="fbm-serve-link" id="fbm-top-roll-link" href="SUBMIT_PAGE_URL_HERE">Roll ↯</a>
  </div>

  <div class="fbm-detail-title" id="fbm-detail-title" style="display:none;">Detail Pertandingan</div>
  <div id="fbm-board-wrap"></div>

  <p class="fbm-feed-title" id="fbm-feed-title" style="display:none;">Feed Pertandingan</p>
  <div class="fbm-feed" id="fbm-feed"></div>
</div>

<script>
(function() {
  var GAS         = 'https://script.google.com/macros/s/AKfycbwhaBkhHXOJObp57Nse9MDM2gtaGGoCTMJFJsyPnlKrriR4sXJ-FFpoQRBvak3EPN5P/exec';
  var SUBMIT_PAGE = 'https://hakgyo.jcink.net/index.php?act=Pages&kid=footballform';
  var curMatch = '';
  var allMatches = [];
  var matchData = null;

  function esc(s) { var d=document.createElement('div'); d.appendChild(document.createTextNode(s==null?'':String(s))); return d.innerHTML; }
  function getParam(n) { var m=window.location.search.match(new RegExp('[?&]'+n+'=([^&]+)')); return m?decodeURIComponent(m[1]):''; }

  function fetchJSON(url, timeoutMs, retries) {
    retries = retries == null ? 2 : retries;
    function attempt(number) {
      var controller = typeof AbortController !== 'undefined' ? new AbortController() : null;
      var opts = controller ? { signal: controller.signal } : {};
      var timeoutId = controller ? setTimeout(function(){ controller.abort(); }, timeoutMs) : null;
      return fetch(url, opts).then(function(r) {
        if (timeoutId) clearTimeout(timeoutId);
        if (!r.ok) throw new Error('http_' + r.status);
        return r.text().then(function(t) { try { return JSON.parse(t); } catch(e) { throw new Error('json_err'); } });
      }).catch(function(err) {
        if (timeoutId) clearTimeout(timeoutId);
        if (number >= retries) throw err;
        var delay = 700 * Math.pow(2, number);
        return new Promise(function(resolve) { setTimeout(resolve, delay); }).then(function() { return attempt(number + 1); });
      });
    }
    return attempt(0);
  }

  function fmtMinute(phase, minute) {
    var label = phase === 'ET1' || phase === 'ET2' ? 'ET ' : '';
    return label + (minute||0) + "'";
  }

  function renderMasterCard(m) {
    var finished = m.status === 'finished';
    var html = '<div class="fbm-master-card'+(finished?' finished':'')+'" data-code="'+esc(m.code)+'">';
    html += '<div class="fbm-master-top"><span class="fbm-master-code">'+esc(m.code)+'</span>';
    html += '<span class="fbm-master-badge">'+esc(m.matchType||'')+'</span></div>';
    html += '<div class="fbm-master-vs">';
    html += '<div class="fbm-master-team"><div class="fbm-master-name">'+esc(m.schoolA||'')+'</div><div class="fbm-master-score">'+(m.scoreA||0)+'</div></div>';
    html += '<div class="fbm-master-vslabel">VS</div>';
    html += '<div class="fbm-master-team right"><div class="fbm-master-name">'+esc(m.schoolB||'')+'</div><div class="fbm-master-score">'+(m.scoreB||0)+'</div></div>';
    html += '</div>';
    html += '<div class="fbm-master-footer">';
    if (finished) {
      var wn = (parseInt(m.scoreA)||0) > (parseInt(m.scoreB)||0) ? m.schoolA : (parseInt(m.scoreB)||0) > (parseInt(m.scoreA)||0) ? m.schoolB : '';
      html += '<span>Selesai</span>';
      html += wn ? '<span class="fbm-master-winner">🏆 '+esc(wn)+'</span>' : '<span class="fbm-master-winner">Seri</span>';
      html += '<span></span>';
    } else {
      html += '<span>'+(m.status==='halftime'?'Istirahat':'Berlangsung')+'</span>';
      html += '<span class="fbm-master-clock">'+esc(fmtMinute(m.phase, m.halfMinute))+'</span>';
      html += '<span></span>';
    }
    html += '</div></div>';
    return html;
  }

  function renderMasterGrid(matches) {
    var root = document.getElementById('fbm-master-grid');
    if (!matches || matches.length === 0) { root.innerHTML = '<div class="fbm-empty">Belum ada pertandingan.</div>'; return; }
    root.innerHTML = '<div class="fbm-master-grid">' + matches.map(renderMasterCard).join('') + '</div>';
    document.querySelectorAll('.fbm-master-card').forEach(function(card) {
      card.addEventListener('click', function() {
        var code = card.getAttribute('data-code');
        document.querySelectorAll('.fbm-master-card').forEach(function(c){ c.classList.remove('selected'); });
        card.classList.add('selected');
        curMatch = code;
        document.getElementById('fbm-detail-title').style.display = 'block';
        loadMatch(code);
        setTimeout(function() {
          var d = document.getElementById('fbm-detail-title');
          if (d) d.scrollIntoView({behavior:'smooth', block:'start'});
        }, 150);
      });
    });
  }

  function loadMatchList(preselect) {
    fetchJSON(GAS+'?action=getAllMatches', 20000, 1).then(function(d) {
      if (d.error) { document.getElementById('fbm-master-grid').innerHTML = '<div class="fbm-empty">'+esc(d.error)+'</div>'; return; }
      allMatches = d.matches || [];
      renderMasterGrid(allMatches);
      if (preselect) {
        curMatch = preselect;
        document.getElementById('fbm-detail-title').style.display = 'block';
        loadMatch(preselect);
        setTimeout(function() {
          var card = document.querySelector('.fbm-master-card[data-code="'+preselect+'"]');
          if (card) card.classList.add('selected');
        }, 100);
      }
    }).catch(function() {
      document.getElementById('fbm-master-grid').innerHTML = '<div class="fbm-empty">Gagal memuat pertandingan. Coba muat ulang halaman.</div>';
    });
  }

  function loadMatch(code) {
    document.getElementById('fbm-board-wrap').innerHTML = '<div class="fbm-loading">Memuat pertandingan...</div>';
    var rollPromise = fetchJSON(GAS+'?action=getRollLog&matchCode='+encodeURIComponent(code)+'&limit=100', 20000, 0);
    var shootPromise = fetchJSON(GAS+'?action=getShootLog&matchCode='+encodeURIComponent(code)+'&limit=50', 20000, 0);
    fetchJSON(GAS+'?action=getScore&matchCode='+encodeURIComponent(code), 25000, 1).then(function(d) {
      matchData = d;
      if (d.error) { document.getElementById('fbm-board-wrap').innerHTML = '<div class="fbm-empty">'+esc(d.error)+'</div>'; return; }
      renderBoard(d);
      loadFeed(rollPromise, shootPromise);
    }).catch(function(){ document.getElementById('fbm-board-wrap').innerHTML = '<div class="fbm-empty">Koneksi gagal. Coba muat ulang halaman.</div>'; });
  }

  function progressBar(label, val, color) {
    var pct = Math.min(100, Math.round((val/50)*100));
    return '<div class="fbm-progress-row"><div class="fbm-progress-label"><span>'+esc(label)+'</span><span>'+val+' / 50</span></div>' +
      '<div class="fbm-progress-bar"><div class="fbm-progress-fill" style="width:'+pct+'%; background:'+color+';"></div></div></div>';
  }

  function renderBoard(d) {
    var isFinished = String(d.status||'').trim().toLowerCase() === 'finished';
    var topWrap = document.getElementById('fbm-top-roll-wrap');
    var topLink = document.getElementById('fbm-top-roll-link');
    if (topWrap && topLink) {
      if (!isFinished) { topLink.href = SUBMIT_PAGE; topWrap.style.display = 'flex'; }
      else { topWrap.style.display = 'none'; }
    }
    var html = '<div class="fbm-board">';
    html += '<span class="fbm-typebadge '+(d.matchType==='PvP'?'pvp':'pvnpc')+'">'+esc(d.matchType||'')+'</span>';
    html += '<span class="fbm-typebadge phase">'+esc(d.phase||'')+'</span>';
    if (d.round) html += '<span class="fbm-typebadge round">'+esc(d.round)+'</span>';
    html += '<div class="fbm-vs-row">';
    html += '<div class="fbm-p-left"><div class="fbm-pname">'+esc(d.schoolA||'')+'</div><div class="fbm-pscore">'+(d.scoreA||0)+'</div></div>';
    html += '<div class="fbm-vs">vs</div>';
    html += '<div class="fbm-p-right"><div class="fbm-pname">'+esc(d.schoolB||'')+'</div><div class="fbm-pscore">'+(d.scoreB||0)+'</div></div>';
    html += '</div>';
    html += progressBar(d.schoolA + ' progress', d.progressA||0, 'var(--accent-2)');
    html += progressBar(d.schoolB + ' progress', d.progressB||0, 'var(--gold)');
    html += '<div class="fbm-clockrow"><div class="fbm-clock">'+esc(fmtMinute(d.phase, d.halfMinute))+'</div><div class="fbm-clocklabel">Waktu Pertandingan</div></div>';
    if (d.status === 'active' && d.shootReady) {
      html += '<div class="fbm-possession-banner">🎯 '+esc(d.shootReady==='A'?d.schoolA:d.schoolB)+' sedang menembak</div>';
    } else if (d.status === 'active' && d.teamInAttack) {
      html += '<div class="fbm-possession-banner">⚽ '+esc(d.teamInAttack==='A'?d.schoolA:d.schoolB)+' sedang menyerang</div>';
    }
    if ((d.redCardsA||0) > 0 || (d.redCardsB||0) > 0) {
      html += '<div class="fbm-cards-row"><span>'+esc(d.schoolA)+': <b>'+(d.redCardsA||0)+' 🟥</b></span><span>'+esc(d.schoolB)+': <b>'+(d.redCardsB||0)+' 🟥</b></span></div>';
    }
    var sc = isFinished ? ' fin' : '';
    html += '<div class="fbm-status'+sc+'">';
    if (isFinished) {
      var wn = (parseInt(d.scoreA)||0) > (parseInt(d.scoreB)||0) ? d.schoolA : (parseInt(d.scoreB)||0) > (parseInt(d.scoreA)||0) ? d.schoolB : '';
      html += wn ? '🏆 PERTANDINGAN SELESAI — '+esc(wn)+' menang '+d.scoreA+'–'+d.scoreB : '🤝 PERTANDINGAN SELESAI — seri '+d.scoreA+'–'+d.scoreB;
    } else if (d.status === 'halftime') {
      html += '⏸️ Menunggu babak/fase berikutnya dimulai.';
    } else if (!d.teamInAttack) {
      html += 'Belum kick off.';
    } else if (d.shootReady) {
      html += '⚽ '+esc(d.shootReady==='A'?d.schoolA:d.schoolB)+' siap menembak'+(SHOOT_TYPE_TAG[d.shootType]||'')+'.';
    } else if (d.pendingRole) {
      var waitingSide = d.pendingSide === 'A' ? 'B' : 'A';
      html += '⏳ Menunggu '+esc(waitingSide==='A'?d.schoolA:d.schoolB)+' menyelesaikan roll.';
    } else {
      html += 'Pertandingan sedang berlangsung.';
    }
    html += '</div></div>';
    document.getElementById('fbm-board-wrap').innerHTML = html;
  }

  var ACTION_LABELS = { dribble: 'Dribble', pass: 'Pass', tackle: 'Tackle', interception: 'Interception', goalkick: 'Goal Kick' };
  var OUTCOME_LABEL = {
    open_play: 'Open play', throwin_attack: 'Throw-in', throwin_defend: 'Throw-in',
    goalkick: 'Goal kick', corner: 'Corner kick!', foul: 'Pelanggaran — Free kick', penalty: 'PENALTI!!'
  };
  var SHOOT_TYPE_TAG = { penalty: ' (penalti!)', corner: ' (tendangan sudut)', freekick: ' (tendangan bebas)' };
  var SHOOT_TYPE_BADGE = { open_play: 'OPEN PLAY', penalty: 'PENALTI', corner: 'CORNER', freekick: 'FREE KICK' };
  var STYLE_LABELS = { pace: '🏃 Pace', power: '💥 Power', skill: '🎯 Skill' };

  // Same continuation phrasing as the roll-submission overlay's
  // OUTCOME_CONTINUATION, translated to Indonesian for this spectator
  // feed (the submission form's own overlay is deliberately English —
  // this page has always been Indonesian, see OUTCOME_LABEL above).
  var OUTCOME_CONTINUATION = {
    throwin_attack: function(att, def) { return 'bola keluar — lemparan ke dalam untuk ' + att + '.'; },
    throwin_defend: function(att, def) { return 'bola keluar — lemparan ke dalam untuk ' + def + '.'; },
    goalkick: function(att, def) { return 'bola keluar untuk goal kick.'; },
    corner: function(att, def) { return 'bola keluar untuk tendangan sudut!'; },
    foul: function(att, def) { return 'terjadi pelanggaran — tendangan bebas diberikan.'; },
    penalty: function(att, def) { return 'PENALTI!! Tendangan penalti diberikan.'; }
  };

  // Builds the 1-2 line narrative for a contest roll, mirroring the
  // submission overlay's contestNarrative() but in Indonesian third
  // person for the public feed.
  function contestNarrative(r, attName, defName, attSchool, defSchool) {
    var defendWon = r.winner === 'defend';
    var lines = [];
    if (defendWon) {
      var cleanVerb = r.actionDefend === 'interception'
        ? ('Intersep bersih dari ' + defName + ' atas operan ' + attName)
        : ('Tekel bersih dari ' + defName + ' terhadap ' + attName);
      lines.push(cleanVerb + ' — ' + defSchool + ' kini menguasai bola.');
      if (r.outcome && r.outcome !== 'open_play' && OUTCOME_CONTINUATION[r.outcome]) {
        var note = OUTCOME_CONTINUATION[r.outcome](attSchool, defSchool);
        lines.push(note.charAt(0).toUpperCase() + note.slice(1));
      }
    } else {
      var verb = r.actionDefend === 'interception' ? 'gagal memotong operan' : 'gagal menekel';
      var cont = OUTCOME_CONTINUATION[r.outcome] ? OUTCOME_CONTINUATION[r.outcome](attSchool, defSchool) : (attSchool + ' masih menguasai bola.');
      lines.push(defName + ' ' + verb + ' ' + attName + ' — ' + cont);
    }
    return lines;
  }

  // One side (name/style/roll column) of the duel row shared by both
  // event card types. position === '' skips the bonus tag entirely
  // (Save never carries a position bonus — see positionGetsBonus on the
  // backend, and ShootLog never even stores a position for the Save side
  // since it's always the registered GK).
  function eventSide(name, bonus, style, roll, align) {
    var html = '<div class="fbm-event-side' + (align === 'right' ? ' right' : '') + '">';
    html += '<div class="fbm-event-name">' + esc(name) + '</div>';
    html += '<div class="fbm-event-style"><span class="dot"></span>' + esc(STYLE_LABELS[style] || '') + '</div>';
    html += '<div class="fbm-event-roll">roll <b>' + roll + '</b></div>';
    if (bonus) html += '<div class="fbm-event-tag bonus">🌟 Bonus posisi</div>';
    html += '</div>';
    return html;
  }

  function renderRollEvent(r) {
    var meta = matchData || {};
    var attName = r.attackSide === 'A' ? meta.schoolA : meta.schoolB;
    var defName = r.defendSide === 'A' ? meta.schoolA : meta.schoolB;
    var progTeam = r.teamProgressed === 'A' ? meta.schoolA : meta.schoolB;
    var narrative = contestNarrative(r, r.characterAttack, r.characterDefend, attName, defName);

    var html = '<div class="fbm-event">';
    html += '<div class="fbm-event-header"><span class="fbm-event-minute">'+esc(fmtMinute(r.phase, r.minute))+'</span>';
    if (r.postedAt) html += '<span class="fbm-event-time">'+esc(r.postedAt)+'</span>';
    html += '</div>';
    if (r.icLine && !r.autoResolved) html += '<div class="fbm-event-ic">'+esc(r.icLine)+'</div>';
    html += '<div class="fbm-event-duel">';
    html += eventSide(r.characterAttack, r.bonusAttack, r.styleAttack, r.rollAttack, 'left');
    html += '<div class="fbm-event-vs">VS</div>';
    html += eventSide(r.characterDefend, r.bonusDefend, r.styleDefend, r.rollDefend, 'right');
    html += '</div>';
    if (r.cardTier === 'Red') html += '<div class="fbm-event-tag card-red">🟥 Kartu Merah — '+esc(r.cardCharacter)+'</div>';
    else if (r.cardTier === 'Yellow') html += '<div class="fbm-event-tag card-yellow">🟨 Kartu Kuning — '+esc(r.cardCharacter)+'</div>';
    if (r.injuryOccurred) html += '<div class="fbm-event-tag injury">🚑 '+esc(r.injuredCharacter)+' cedera</div>';
    html += '<div class="fbm-event-summary">'+esc(OUTCOME_LABEL[r.outcome]||'Open play')+' · Margin <b>'+r.margin+'</b> · +'+r.progressGained+' progress untuk '+esc(progTeam)+'</div>';
    html += '<div class="fbm-event-narrative">' + narrative.map(function(l){ return '<p>'+esc(l)+'</p>'; }).join('') + '</div>';
    if (r.autoResolved) html += '<div class="fbm-event-autotag">'+esc(r.icLine)+'</div>';
    html += '</div>';
    return html;
  }

  function renderShootEvent(s) {
    var outcomeLabel = s.outcome === 'goal' ? 'GOL! ⚽' : s.outcome === 'offside' ? 'Offside — gol dianulir' : 'Diselamatkan!';
    var html = '<div class="fbm-event">';
    html += '<div class="fbm-event-header"><span class="fbm-event-minute">'+esc(fmtMinute(s.phase, s.minute))+' · '+esc(SHOOT_TYPE_BADGE[s.shootType]||'SHOOT')+'</span>';
    if (s.postedAt) html += '<span class="fbm-event-time">'+esc(s.postedAt)+'</span>';
    html += '</div>';
    if (s.icLine && !s.autoResolved) html += '<div class="fbm-event-ic">'+esc(s.icLine)+'</div>';
    html += '<div class="fbm-event-duel">';
    html += eventSide(s.characterShoot, s.bonusShoot, s.styleShoot, s.rollShoot, 'left');
    html += '<div class="fbm-event-vs">VS</div>';
    html += eventSide(s.characterSave, false, s.styleSave, s.rollSave, 'right');
    html += '</div>';
    if (s.outcome === 'goal') html += '<div class="fbm-tag-goal">'+outcomeLabel+'</div>';
    html += '<div class="fbm-event-summary">'+(s.outcome!=='goal'?esc(outcomeLabel)+' · ':'')+'Margin <b>'+s.margin+'</b> · Skor <b>'+s.scoreAAfter+'–'+s.scoreBAfter+'</b></div>';
    if (s.flavorText) html += '<div class="fbm-event-narrative"><p>'+esc(s.flavorText)+'</p></div>';
    if (s.autoResolved) html += '<div class="fbm-event-autotag">'+esc(s.icLine)+'</div>';
    html += '</div>';
    return html;
  }

  function loadFeed(rollPromise, shootPromise) {
    document.getElementById('fbm-feed-title').style.display = 'block';
    document.getElementById('fbm-feed').innerHTML = '<div class="fbm-loading">Memuat feed...</div>';
    Promise.all([rollPromise, shootPromise]).then(function(results) {
      var rolls = (results[0] && results[0].rolls) || [];
      var shots = (results[1] && results[1].shots) || [];
      var events = [];
      rolls.forEach(function(r) { events.push({ type: 'roll', data: r, sortKey: r.postedAt || '' }); });
      shots.forEach(function(s) { events.push({ type: 'shoot', data: s, sortKey: s.postedAt || '' }); });
      events.sort(function(a,b) { return a.sortKey < b.sortKey ? 1 : a.sortKey > b.sortKey ? -1 : 0; });
      if (events.length === 0) { document.getElementById('fbm-feed').innerHTML = '<div class="fbm-empty">Belum ada roll. Mulai pertandingan!</div>'; return; }
      var html = events.map(function(e) { return e.type === 'roll' ? renderRollEvent(e.data) : renderShootEvent(e.data); }).join('');
      document.getElementById('fbm-feed').innerHTML = html;
    }).catch(function() { document.getElementById('fbm-feed').innerHTML = '<div class="fbm-empty">Gagal memuat feed.</div>'; });
  }

  var im = getParam('match');
  loadMatchList(im);
})();
</script>
