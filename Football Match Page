.fbm-clockrow { border-top: 1px solid rgba(255,255,255,0.15); margin-top: 0.6rem; padding-top: 0.75rem; text-align: center; }
.fbm-clock { font-family: 'IBM Plex Mono', monospace; font-size: 1.1rem; color: var(--text-on-deep); font-weight: bold; }
.fbm-clocklabel { font-family: 'IBM Plex Mono', monospace; font-size: 0.58rem; letter-spacing: 1px; text-transform: uppercase; color: var(--text-on-deep-secondary); margin-top: 0.2rem; }
